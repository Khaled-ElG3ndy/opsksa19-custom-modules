<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gr_rental_order_form_billing" model="ir.ui.view">
        <field name="name">gr.rental.order.form.billing</field>
        <field name="model">gr.rental.order</field>
        <field name="inherit_id" ref="gr_rental_order.view_gr_rental_order_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//form/header/field[@name='state']" position="before">
                <button name="action_create_invoice" type="object"
                        string="Create Invoice" class="btn-primary"
                        invisible="state not in ('confirmed','reserved','dispatched','installed','on_rent','off_hire_requested','returned','inspection','closed')"
                        groups="gr_security_base.group_generator_finance_officer"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_invoices" type="object"
                        class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="invoice_count == 0">
                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </xpath>
            <xpath expr="//form/sheet" position="inside">
                <field name="billable_log_count" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
