<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_rental_order" model="ir.ui.view">
        <field name="name">account.move.form.rental.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_origin']" position="after">
                <field name="rental_order_id" readonly="1" invisible="not rental_order_id"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="rental_asset_type" readonly="1" optional="show"/>
                <field name="rental_equipment_reference" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_rental_order" model="ir.ui.view">
        <field name="name">account.move.out.invoice.list.rental.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="rental_order_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_rental_order" model="ir.ui.view">
        <field name="name">account.invoice.search.rental.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="rental_order_id"/>
            </xpath>
            <xpath expr="//filter[@name='partner']" position="after">
                <filter string="Rental Order" name="rental_order"
                        context="{'group_by':'rental_order_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
