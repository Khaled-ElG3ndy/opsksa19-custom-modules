<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_bom_form_view_inherited" model="ir.ui.view">
            <field name="name">mrp.bom.form</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="/form/sheet/group/group/field[@name='product_id']" position="after">
                    <field name="is_recipe"/>
                    <field name="yield_percentage" invisible="is_recipe != True" widget="percentage"/>
                    <field name="bom_qty" invisible="is_recipe != True"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>