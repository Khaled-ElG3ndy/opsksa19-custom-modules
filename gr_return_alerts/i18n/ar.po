#. module: gr_return_alerts
#. odoo-python
#: code:addons/gr_return_alerts/models/gr_rental_order_alert.py:0
msgid ""
"Rental order %(order)s for customer %(customer)s and asset %(asset)s is due "
"for return today, %(return_date)s. Please follow up with the customer and "
"confirm collection of the asset today."
msgstr ""
"أمر التأجير %(order)s للعميل %(customer)s والأصل %(asset)s مستحق الإرجاع "
"اليوم، %(return_date)s. يُرجى المتابعة مع العميل وتأكيد استلام الأصل اليوم."

#. module: gr_return_alerts
#. odoo-python
#: code:addons/gr_return_alerts/models/gr_rental_order_alert.py:0
msgid ""
"Rental order %(order)s for customer %(customer)s and asset %(asset)s is "
"expected to be returned on %(return_date)s. There are 3 business days "
"remaining. Please contact the customer and confirm that the asset will be "
"ready for return on time."
msgstr ""
"من المتوقع إرجاع أمر التأجير %(order)s للعميل %(customer)s والأصل %(asset)s "
"في %(return_date)s. متبقٍ 3 أيام عمل. يُرجى التواصل مع العميل وتأكيد جاهزية "
"الأصل للإرجاع في موعده."

#. module: gr_return_alerts
#. odoo-python
#: code:addons/gr_return_alerts/models/gr_rental_order_alert.py:0
msgid ""
"Rental order %(order)s for customer %(customer)s and asset %(asset)s was due"
" for return on %(return_date)s and is now overdue by %(overdue_days)s "
"business day(s). Please take the required action and contact the customer "
"immediately."
msgstr ""
"كان إرجاع أمر التأجير %(order)s للعميل %(customer)s والأصل %(asset)s مستحقًا"
" في %(return_date)s وهو الآن متأخر بمقدار %(overdue_days)s يوم عمل. يُرجى "
"اتخاذ الإجراء اللازم والتواصل مع العميل فورًا."

