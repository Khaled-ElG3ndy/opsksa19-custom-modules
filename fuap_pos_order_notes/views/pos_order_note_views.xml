<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_note_list" model="ir.ui.view">
        <field name="name">pos.order.note.list</field>
        <field name="model">pos.order.note</field>
        <field name="arch" type="xml">
            <list string="Order Notes Tags" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_pos_order_note_form" model="ir.ui.view">
        <field name="name">pos.order.note.form</field>
        <field name="model">pos.order.note</field>
        <field name="arch" type="xml">
            <form string="Order Notes Tag">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Order assembled"/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_order_note" model="ir.actions.act_window">
        <field name="name">Order Notes Tags</field>
        <field name="res_model">pos.order.note</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a predefined order note</p>
            <p>Cashiers can insert these tags from the Order Note popup.</p>
        </field>
    </record>
</odoo>

