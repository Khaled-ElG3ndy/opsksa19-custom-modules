<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gr_maintenance_template_form" model="ir.ui.view">
        <field name="name">gr.maintenance.template.form</field>
        <field name="model">gr.maintenance.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="default_interval_hours"/>
                            <field name="default_interval_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Template description..."/>
                    <field name="checklist_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="note"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gr_maintenance_template_list" model="ir.ui.view">
        <field name="name">gr.maintenance.template.list</field>
        <field name="model">gr.maintenance.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_type"/>
                <field name="default_interval_hours"/>
                <field name="default_interval_days"/>
            </list>
        </field>
    </record>

    <record id="action_gr_maintenance_template" model="ir.actions.act_window">
        <field name="name">PM Templates</field>
        <field name="res_model">gr.maintenance.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
