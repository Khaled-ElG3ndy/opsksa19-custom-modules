<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_kitchen_receipt_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.kitchen.receipt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="print_kitchen_notes_receipt"
                         string="Kitchen Note on Receipt"
                         help="Display kitchen notes on POS preparation receipts.">
                    <field name="print_kitchen_notes_receipt"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
