<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_kitchen_receipt.OrderChangeReceipt"
       t-inherit="point_of_sale.OrderChangeReceipt"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-body')]/div[hasclass('new-changes')][1]"
               position="after">
            <!-- Core prints data.general_customer_note itself, but only when the
                 receipt carries no line changes. Repeating it there would print
                 the same note twice; everywhere else this is the only line that
                 carries it. -->
            <div t-if="data.order_note and (hasDataChanges or data.order_note != data.general_customer_note)"
                 class="pos-order-notes mt-3">
                Note :
                <span class="pos-receipt-right-align">
                    <i><t t-esc="data.order_note"/></i>
                </span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="style" add="font-size: 25px;" separator=" "/>
        </xpath>
    </t>
</templates>
