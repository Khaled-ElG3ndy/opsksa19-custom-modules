<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gr_generator_asset_form_history" model="ir.ui.view">
        <field name="name">gr.generator.asset.form.history</field>
        <field name="model">gr.generator.asset</field>
        <field name="inherit_id" ref="gr_fleet_base.view_gr_generator_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_history_rental_orders" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="history_rental_order_count == 0">
                    <field name="history_rental_order_count" widget="statinfo" string="Rentals"/>
                </button>
                <button name="action_view_history_contracts" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="history_contract_count == 0">
                    <field name="history_contract_count" widget="statinfo" string="Contracts"/>
                </button>
                <button name="action_view_history_deliveries" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="history_delivery_count == 0">
                    <field name="history_delivery_count" widget="statinfo" string="Deliveries"/>
                </button>
                <button name="action_view_history_returns" type="object"
                        class="oe_stat_button" icon="fa-undo"
                        invisible="history_return_count == 0">
                    <field name="history_return_count" widget="statinfo" string="Returns"/>
                </button>
                <button name="action_view_history_repairs" type="object"
                        class="oe_stat_button" icon="fa-exclamation-triangle"
                        invisible="history_repair_count == 0">
                    <field name="history_repair_count" widget="statinfo" string="Issues"/>
                </button>
                <button name="action_view_history_inspections" type="object"
                        class="oe_stat_button" icon="fa-check-square-o"
                        invisible="history_inspection_count == 0">
                    <field name="history_inspection_count" widget="statinfo" string="Inspections"/>
                </button>
                <button name="action_view_history_visits" type="object"
                        class="oe_stat_button" icon="fa-map-marker"
                        invisible="history_visit_count == 0">
                    <field name="history_visit_count" widget="statinfo" string="Visits"/>
                </button>
                <button name="action_view_asset_history" type="object"
                        class="oe_stat_button" icon="fa-history"
                        invisible="history_event_count == 0">
                    <field name="history_event_count" widget="statinfo" string="History"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='current_rental_order_ref']" position="after">
                <separator string="Current Position"/>
                <field name="current_presence_type"/>
                <field name="current_rental_order_id"/>
                <field name="current_contract_id"/>
                <field name="current_site_id"/>
                <field name="current_location_label"/>
                <field name="expected_return_datetime"/>
                <field name="history_last_event_datetime"/>
            </xpath>

            <xpath expr="//notebook/page[@name='notes']" position="before">
                <page string="Asset History" name="asset_history">
                    <group string="Lifetime Summary">
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="current_customer_id" readonly="1"/>
                            <field name="current_site_id" readonly="1"/>
                            <field name="current_location_label" readonly="1"/>
                            <field name="current_rental_order_id" readonly="1"/>
                            <field name="expected_return_datetime" readonly="1"/>
                        </group>
                        <group>
                            <field name="history_rental_order_count" readonly="1"/>
                            <field name="history_total_rental_days" readonly="1"/>
                            <field name="maintenance_job_count" readonly="1"/>
                            <field name="history_last_maintenance_id" readonly="1"/>
                            <field name="history_last_maintenance_date" readonly="1"/>
                            <field name="next_pm_date" readonly="1"/>
                            <field name="next_pm_hour" readonly="1"/>
                            <field name="history_breakdown_count" readonly="1"/>
                            <field name="history_total_parts_cost" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Rental Operations"/>
                    <field name="history_rental_line_ids" readonly="1">
                        <list create="0" edit="0" delete="0"
                              decoration-muted="state == 'cancelled'"
                              decoration-success="state == 'closed'"
                              decoration-info="state in ('reserved','dispatched','installed','on_rent')">
                            <field name="rental_order_id"/>
                            <field name="asset_role" widget="badge"/>
                            <field name="partner_id"/>
                            <field name="contract_id"/>
                            <field name="site_id"/>
                            <field name="start_datetime"/>
                            <field name="planned_return_datetime"/>
                            <field name="actual_return_datetime"/>
                            <field name="duration_days"/>
                            <field name="daily_rate"/>
                            <field name="revenue_amount"/>
                            <field name="is_free"/>
                            <field name="state" widget="badge"/>
                            <button name="action_open_rental_order" type="object"
                                    icon="fa-external-link" string="Open Rental Order"/>
                        </list>
                    </field>
                    <separator string="Timeline"/>
                    <field name="history_ids" readonly="1"
                           domain="[('is_technical_event', '=', False)]"
                           context="{'default_asset_id': id}">
                        <list create="0" edit="0" delete="0"
                              decoration-info="event_type in ('rental_confirmed','asset_reserved','delivery','installed','rental_started','rental_extended')"
                              decoration-warning="event_type in ('maintenance_opened','maintenance_started','inspection_started','off_hire_requested')"
                              decoration-danger="event_type in ('breakdown_reported','damage_found','inspection_failed','asset_retired')"
                              decoration-success="event_type in ('return','maintenance_done','inspection_passed','rental_closed','vendor_returned')">
                            <field name="event_datetime" string="Date &amp; Time"/>
                            <field name="event_type" string="Event Type" widget="badge"/>
                            <field name="name" string="Details"/>
                            <field name="partner_id" string="Customer"/>
                            <field name="location_label" string="Location"/>
                            <field name="old_state"/>
                            <field name="new_state"/>
                            <field name="source_reference" string="Source Reference"/>
                            <field name="user_id" string="Responsible User"/>
                            <button name="action_open_source" type="object" icon="fa-external-link"
                                    string="Open Source" title="Open Source" invisible="not source_model"/>
                        </list>
                    </field>
                    <separator string="Maintenance and Repairs"/>
                    <field name="maintenance_job_ids" readonly="1">
                        <list create="0" edit="0" delete="0"
                              decoration-danger="job_type == 'breakdown'"
                              decoration-success="state == 'done'"
                              decoration-muted="state == 'cancelled'">
                            <field name="name"/>
                            <field name="job_type"/>
                            <field name="scheduled_date"/>
                            <field name="started_date"/>
                            <field name="completed_date"/>
                            <field name="technician_id"/>
                            <field name="state" widget="badge"/>
                            <field name="meter_at_service"/>
                            <field name="labor_hours"/>
                            <field name="downtime_hours"/>
                            <field name="total_parts_cost"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
