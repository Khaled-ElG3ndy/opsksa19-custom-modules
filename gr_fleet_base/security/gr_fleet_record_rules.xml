<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company isolation: users only see assets of companies they
             belong to. Administrators are not exempted from company scoping,
             which is correct Odoo multi-company behaviour (company switching
             governs visibility). -->
        <record id="rule_gr_generator_asset_company" model="ir.rule">
            <field name="name">Generator Asset: multi-company</field>
            <field name="model_id" ref="model_gr_generator_asset"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
