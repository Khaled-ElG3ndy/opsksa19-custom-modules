<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_strx_cabin_shipping_order" model="ir.sequence">
        <field name="name">Cabin Shipping Order</field>
        <field name="code">strx.cabin.shipping.order</field>
        <field name="prefix">WB/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_strx_cabin_broker_payment" model="ir.sequence">
        <field name="name">Broker Payment Order</field>
        <field name="code">strx.cabin.broker.payment</field>
        <field name="prefix">BPO/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
