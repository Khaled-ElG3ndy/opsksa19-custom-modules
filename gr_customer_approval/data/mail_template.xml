<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_template_rental_order_approval_code" model="mail.template">
        <field name="name">Customer Approval Code - Rental Order</field>
        <field name="model_id" ref="gr_rental_order.model_gr_rental_order"/>
        <field name="subject">{{ object._approval_email_subject() }}</field>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="body_html" type="html">
            <t t-out="object._approval_email_body_html()"/>
        </field>
    </record>

