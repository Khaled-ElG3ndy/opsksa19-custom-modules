<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Odoo 19 unified the four external layouts. Every header is now
            <div t-attf-class="header o_company_#{company.id}_layout">
        and every footer
            <div t-attf-class="footer o_company_#{company.id}_layout {{...}}">
        The per-layout marker classes this module used to hook onto
        (o_boxed_header, o_clean_header, o_standard_footer, o_boxed_footer,
        o_clean_footer, o_background_footer) no longer exist at all.

        Rather than replace each header and footer with a copy of the core
        markup - which is what made this module break on every release - we
        now only:
          1. add a t-if to the core block so it stands down when a custom
             image is set, and
          2. insert our own block beside it.
        Nothing inside the core blocks is touched, so upstream restyling
        cannot break us.
    -->

    <template id="full_width_header">
        <div t-if="company.header_img"
             t-attf-class="header o_company_#{company.id}_layout o_full_width_header">
            <img t-att-src="image_data_uri(company.header_img)"
                 alt="" style="width:100%; max-width:100%; display:block;"/>
        </div>
    </template>

    <template id="full_width_footer">
        <div t-if="company.footer_img"
             t-attf-class="footer o_company_#{company.id}_layout o_full_width_footer">
            <img t-att-src="image_data_uri(company.footer_img)"
                 alt="" style="width:100%; max-width:100%; display:block;"/>
            <div t-if="report_type == 'pdf'" class="text-center text-muted" style="font-size:8px;">
                <span class="page"/> / <span class="topage"/>
            </div>
        </div>
    </template>

    <!--
        The two xpaths below are identical in all four layouts and each
        matches exactly one node. The "attributes" step has to come first:
        once our own block is in place the selector would otherwise be
        ambiguous. Our block goes in through t-call, so it is a <t> and can
        never match a //div selector anyway.
    -->

    <template id="external_layout_standard_inherit" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.header_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_header"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.footer_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_footer"/>
        </xpath>
    </template>

    <template id="external_layout_boxed_inherit" inherit_id="web.external_layout_boxed">
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.header_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_header"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.footer_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_footer"/>
        </xpath>
    </template>

    <template id="external_layout_bold_inherit" inherit_id="web.external_layout_bold">
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.header_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_header"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.footer_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_footer"/>
        </xpath>
    </template>

    <template id="external_layout_striped_inherit" inherit_id="web.external_layout_striped">
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.header_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_header"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.footer_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_footer"/>
        </xpath>
    </template>

    <!--
        Odoo 19 ships seven external layouts, not the four this module was
        written against. folder, wave and bubble carry the same header and
        footer markup as the rest, so the same two xpaths apply; leaving them
        out meant a company that picked one of them got no custom letterhead at
        all, and nothing said so.
    -->

    <template id="external_layout_folder_inherit" inherit_id="web.external_layout_folder">
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.header_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_header"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.footer_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_footer"/>
        </xpath>
    </template>

    <template id="external_layout_wave_inherit" inherit_id="web.external_layout_wave">
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.header_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_header"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.footer_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_footer"/>
        </xpath>
    </template>

    <template id="external_layout_bubble_inherit" inherit_id="web.external_layout_bubble">
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.header_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_header"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="attributes">
            <attribute name="t-if">not company.footer_img</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer') and contains(@t-attf-class, 'o_company_#{company.id}_layout')]" position="before">
            <t t-call="document_layout_header.full_width_footer"/>
        </xpath>
    </template>

</odoo>
