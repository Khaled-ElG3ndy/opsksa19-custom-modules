<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="external_layout_standard_inherit" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(@t-attf-class, 'header o_company_#{company.id}_layout')]" position="replace">
            <!-- Custom Header Image -->
            <div t-if="company.header_img" t-attf-class="header o_company_#{company.id}_layout"
                 t-att-style="report_header_style">
                <div class="row">
                    <div class="col-12 mb-4">
                        <img t-att-src="image_data_uri(company.header_img)" alt="Header Image"
                             style="width: 100%; max-width: 100%; "/>
                    </div>
                </div>
            </div>
            <!-- Original header layout -->
            <div t-if="not company.header_img" t-attf-class="header o_company_#{company.id}_layout"
                 t-att-style="report_header_style">
                <div class="row">
                    <div class="col-3 mb4">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;"
                             alt="Logo"/>
                    </div>
                    <div class="col-9 text-end" style="margin-top:22px;" t-if="company.report_header"
                         t-field="company.report_header" name="moto">Company tagline
                    </div>
                </div>
                <div t-if="company.logo or company.report_header" class="row zero_min_height">
                    <div class="col-12">
                        <div style="border-bottom: 1px solid black;"/>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6" name="company_address">
                        <ul class="list-unstyled" name="company_address_list">
                            <li t-if="company.is_company_details_empty">
                                <span t-field="company.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                        <strong>Company address block</strong>
                                        <div>Contains the company address.</div>
                                    </div>
                                </span>
                            </li>
                            <li t-else="">
                                <span t-field="company.company_details">
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                        <strong>Company details block</strong>
                                        <div>Contains the company details.</div>
                                    </div>
                                </span>
                            </li>
                            <li t-if="not forced_vat"/>
                            <li t-else="">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                <span t-esc="forced_vat">US12345671</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'footer o_standard_footer o_company_#{company.id}_layout')]"
               position="replace">
            <div t-if="company.footer_img" t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
                <div class="text-center" style="border-top: 1px solid black;">
                    <img t-att-src="image_data_uri(company.footer_img)"
                         style="width: 100%; max-width: 100%; "
                         alt="Footer Image"/>
                </div>
            </div>
            <div t-if="not company.footer_img" t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
                <div class="text-center" style="border-top: 1px solid black;">
                    <ul class="list-inline mb4">
                        <div t-field="company.report_footer"/>
                    </ul>
                    <div t-if="report_type == 'pdf'" class="text-muted">
                        Page:
                        <span class="page"/>
                        /
                        <span class="topage"/>
                    </div>
                    <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                        <span t-out="o.name">(document name)</span>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="external_layout_boxed_inherit" inherit_id="web.external_layout_boxed">
        <xpath expr="//div[@class='o_boxed_header']" position="replace">
            <div t-if="company.header_img" class="o_boxed_header">
                <div class="row mb8">
                    <img t-att-src="image_data_uri(company.header_img)"
                         style="width: 100%; max-width: 100%; "
                         alt="Header Image"/>
                </div>
            </div>
            <div t-if="not company.header_img" class="o_boxed_header">
                <div class="row mb8">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                    </div>
                    <div class="col-6 text-end mb4">
                        <t t-if="company.report_header and company.report_header.strip() != '&lt;p&gt;&lt;br&gt;&lt;/p&gt;'">
                            <div class="mt0 h4" t-field="company.report_header"/>
                        </t>
                        <div name="company_address" class="float-end mb4">
                            <ul class="list-unstyled" name="company_address_list">
                                <li t-if="company.is_company_details_empty">
                                    <span t-field="company.partner_id"
                                          t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                                        <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                            <strong>Company address block</strong>
                                            <div>Contains the company address.</div>
                                        </div>
                                    </span>
                                </li>
                                <li t-else="">
                                    <span t-field="company.company_details">
                                        <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                            <strong>Company details block</strong>
                                            <div>Contains the company details.</div>
                                        </div>
                                    </span>
                                </li>
                                <li t-if="not forced_vat"/>
                                <li t-else="">
                                    <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                    <span t-esc="forced_vat">US12345671</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer o_boxed_footer o_company_#{company.id}_layout')]"
               position="replace">
            <div t-if="company.footer_img" t-attf-class="footer o_boxed_footer o_company_#{company.id}_layout">
                <div class="text-center">
                    <img t-att-src="image_data_uri(company.footer_img)"
                         style="width: 100%; max-width: 100%; "
                         alt="Footer Image"/>
                </div>
            </div>
            <div t-if="not company.footer_img" t-attf-class="footer o_boxed_footer o_company_#{company.id}_layout">
                <div class="text-center">
                    <div t-field="company.report_footer">Company Report Footer</div>
                    <div t-if="report_type == 'pdf'">
                        Page:
                        <span class="page"/>
                        /
                        <span class="topage"/>
                    </div>
                    <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                        <span t-out="o.name">(document name)</span>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="external_layout_bold_inherit" inherit_id="web.external_layout_bold">
        <xpath expr="//div[@class='o_clean_header']" position="replace">
            <div t-if="company.header_img" class="o_clean_header">
                <div class="row">
                    <img t-att-src="image_data_uri(company.header_img)"
                         style="width: 100%; max-width: 100%; "
                         alt="Header Image"/>
                </div>
            </div>
            <div t-if="not company.header_img" class="o_clean_header">
                <div class="row">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                    </div>
                    <div class="col-5 offset-1" name="company_address">
                        <ul class="list-unstyled" name='company_address_list'>
                            <li t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                    <strong>Company address block</strong>
                                    <div>Contains the company address.</div>
                                </div>
                            </span></li>
                            <li t-else="">
                                <span t-field="company.company_details">
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                        <strong>Company details block</strong>
                                        <div>Contains the company details.</div>
                                    </div>
                                </span>
                            </li>
                            <li t-if="not forced_vat"/>
                            <li t-else="">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                <span t-esc="forced_vat">US12345671</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer o_clean_footer o_company_#{company.id}_layout')]" position="replace">
            <div t-if="company.footer_img" t-attf-class="footer o_clean_footer o_company_#{company.id}_layout">
                <div class="row">
                    <img t-att-src="image_data_uri(company.footer_img)"
                         style="width: 100%; max-width: 100%; "
                         alt="Footer Image"/>
                </div>
            </div>
            <div t-if="not company.footer_img" t-attf-class="footer o_clean_footer o_company_#{company.id}_layout">
                <div class="row">
                    <div class="col-4">
                        <span t-field="company.report_footer"/>
                    </div>
                    <div class="col-4">
                        <span t-if="company.is_company_details_empty" t-field="company.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                        <span t-else="" t-field="company.company_details"/>
                    </div>
                    <div class="col-3">
                        <div class="mt0 mb0 h5" t-if="company.report_header" t-field="company.report_header">Company
                            tagline
                        </div>
                    </div>
                    <div class="col-1">
                        <ul t-if="report_type == 'pdf'" class="list-inline pagenumber float-end text-center">
                            <li class="list-inline-item">
                                <strong>
                                    <span class="page"/>
                                </strong>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="external_layout_striped_inherit" inherit_id="web.external_layout_striped">
        <xpath expr="//div[contains(@t-attf-class, 'o_company_#{company.id}_layout header')]" position="replace">
            <div t-if="company.header_img" t-attf-class="o_company_#{company.id}_layout header"
                 t-att-style="report_header_style">
                <div class="o_background_header">
                    <img t-att-src="image_data_uri(company.header_img)"
                         style="width: 100%; max-width: 100%; "
                         alt="Header Image"/>
                    <div class="clearfix mb8"/>
                </div>
            </div>
            <div t-if="not company.header_img" t-attf-class="o_company_#{company.id}_layout header"
                 t-att-style="report_header_style">
                <div class="o_background_header">
                    <div class="float-end">
                        <div class="mt0 text-end h3" t-if="company.report_header" t-field="company.report_header">
                            Company tagline
                        </div>
                    </div>
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" class="float-start" alt="Logo"/>
                    <div class="float-start company_address">
                        <ul class="list-unstyled" name='company_address_list'>
                            <li t-if="company.is_company_details_empty">
                                <span t-field="company.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                        <strong>Company address block</strong>
                                        <div>Contains the company address.</div>
                                    </div>
                                </span>
                            </li>
                            <li t-else="">
                                <span t-field="company.company_details">
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                        <strong>Company details block</strong>
                                        <div>Contains the company details.</div>
                                    </div>
                                </span>
                            </li>
                            <li t-if="not forced_vat"/>
                            <li t-else="">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                <span t-esc="forced_vat">US12345671</span>
                            </li>
                        </ul>
                    </div>
                    <div class="clearfix mb8"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'o_company_#{company.id}_layout footer o_background_footer')]" position="replace">
            <div t-if="company.footer_img" t-attf-class="o_company_#{company.id}_layout footer o_background_footer">
                <div class="text-center">
                    <img t-att-src="image_data_uri(company.footer_img)"
                         style="width: 100%; max-width: 100%; "
                         alt="Footer Image"/>
                </div>
            </div>
            <div t-if="not company.footer_img" t-attf-class="o_company_#{company.id}_layout footer o_background_footer">
                <div class="text-center">
                    <ul class="list-inline">
                        <div t-field="company.report_footer"/>
                    </ul>
                    <div t-if="report_type == 'pdf'" class="text-muted">
                        Page:
                        <span class="page"/>
                        of
                        <span class="topage"/>
                    </div>
                    <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                        <span t-out="o.name">(document name)</span>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
