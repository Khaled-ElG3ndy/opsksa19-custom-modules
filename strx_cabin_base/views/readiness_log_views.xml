<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_strx_readiness_log_list" model="ir.ui.view">
        <field name="name">strx.cabin.readiness.log.list</field>
        <field name="model">strx.cabin.readiness.log</field>
        <field name="arch" type="xml">
            <list string="Readiness History" create="0" edit="0">
                <field name="event_date"/>
                <field name="lot_id"/>
                <field name="product_id" optional="show"/>
                <field name="old_state"/>
                <field name="new_state"/>
                <field name="condition" optional="show"/>
                <field name="reason" optional="show"/>
                <field name="user_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_strx_readiness_log_form" model="ir.ui.view">
        <field name="name">strx.cabin.readiness.log.form</field>
        <field name="model">strx.cabin.readiness.log</field>
        <field name="arch" type="xml">
            <form string="Readiness Event">
                <sheet>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="product_id"/>
                            <field name="event_date"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="old_state"/>
                            <field name="new_state"/>
                            <field name="condition"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_strx_readiness_log_search" model="ir.ui.view">
        <field name="name">strx.cabin.readiness.log.search</field>
        <field name="model">strx.cabin.readiness.log</field>
        <field name="arch" type="xml">
            <search string="Readiness History">
                <field name="lot_id"/>
                <field name="product_id"/>
                <filter name="grp_cabin" string="Cabin" context="{'group_by': 'lot_id'}"/>
                <filter name="grp_state" string="New State" context="{'group_by': 'new_state'}"/>
            </search>
        </field>
    </record>

    <record id="action_strx_readiness_log" model="ir.actions.act_window">
        <field name="name">Readiness History</field>
        <field name="res_model">strx.cabin.readiness.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
