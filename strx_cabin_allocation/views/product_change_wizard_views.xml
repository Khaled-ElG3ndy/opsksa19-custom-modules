<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_strx_product_change_wizard_form" model="ir.ui.view">
        <field name="name">strx.sale.product.change.wizard.form</field>
        <field name="model">strx.sale.product.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Cabin Product">
                <group>
                    <field name="original_order_id" string="Original Order"/>
                    <field name="reason" string="Reason"
                           placeholder="Why is the customer changing the cabin type or size?"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="order_line_id" column_invisible="1" force_save="1"/>
                        <field name="current_product_id" readonly="1"/>
                        <field name="proposed_product_id"
                               domain="[('strx_is_cabin', '=', True), ('sale_ok', '=', True)]"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply_product_change" type="object"
                            string="Apply Change" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
