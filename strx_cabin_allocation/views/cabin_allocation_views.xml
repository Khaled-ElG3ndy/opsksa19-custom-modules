<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_strx_cabin_allocation_list" model="ir.ui.view">
        <field name="name">strx.cabin.allocation.list</field>
        <field name="model">strx.cabin.allocation</field>
        <field name="arch" type="xml">
            <list string="Cabin Allocations"
                  decoration-muted="state == 'cancel'"
                  decoration-success="state in ('allocated', 'available')">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id" optional="show"/>
                <field name="strx_cabin_spec" string="Specification"/>
                <field name="lot_ids" widget="many2many_tags"/>
                <field name="strx_date_out" optional="show"/>
                <field name="strx_expected_return_date" optional="show"/>
                <field name="strx_rental_days" optional="hide"/>
                <field name="strx_return_alert_count" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('allocated', 'available')"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_strx_cabin_allocation_form" model="ir.ui.view">
        <field name="name">strx.cabin.allocation.form</field>
        <field name="model">strx.cabin.allocation</field>
        <field name="arch" type="xml">
            <form string="Cabin Allocation">
                <header>
                    <button name="action_allocate" type="object" string="Allocate"
                            class="oe_highlight"
                            invisible="state not in ('draft',)"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancel', 'done', 'available')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft" invisible="state != 'cancel'"/>
                    <button name="action_open_return_assessment" type="object"
                            string="Assess Returned Cabins" class="oe_highlight"
                            groups="stock.group_stock_user"
                            invisible="state != 'returned' or not lot_ids"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,allocated,dispatched,on_rent,returned,available"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Rental">
                            <field name="order_line_id"
                                   domain="[('order_id.state','=','sale'), ('display_type','=',False)]"/>
                            <field name="order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group string="Specification &amp; Serial">
                            <field name="product_id" readonly="1"/>
                            <field name="strx_cabin_spec"/>
                            <field name="lot_id" invisible="1"/>
                            <field name="lot_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="strx_all_lots_available" invisible="1"/>
                            <field name="strx_lot_readiness_state" widget="badge"
                                   decoration-success="strx_lot_readiness_state == 'available'"
                                   decoration-danger="strx_lot_readiness_state in ('returned', 'damaged')"
                                   decoration-warning="strx_lot_readiness_state in ('in_inspection', 'in_cleaning', 'in_maintenance')"/>
                        </group>
                        <group string="Rental Period">
                            <field name="strx_date_out"/>
                            <field name="strx_expected_return_date"/>
                            <field name="strx_rental_days"/>
                            <field name="strx_actual_return_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_strx_cabin_allocation_search" model="ir.ui.view">
        <field name="name">strx.cabin.allocation.search</field>
        <field name="model">strx.cabin.allocation</field>
        <field name="arch" type="xml">
            <search string="Cabin Allocations">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="lot_ids"/>
                <field name="product_id"/>
                <filter name="f_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="f_allocated" string="Allocated"
                        domain="[('state','=','allocated')]"/>
                <filter name="f_dispatched" string="Dispatched"
                        domain="[('state','=','dispatched')]"/>
                <filter name="f_on_rent" string="On Rent"
                        domain="[('state','=','on_rent')]"/>
                <filter name="f_returned" string="Returned"
                        domain="[('state','=','returned')]"/>
                <filter name="f_assessed" string="Assessed"
                        domain="[('state','=','available')]"/>
                <filter name="f_done" string="Done"
                        domain="[('state','=','done')]"/>
                <filter name="f_cancelled" string="Cancelled"
                        domain="[('state','=','cancel')]"/>
                <separator/>
                <filter name="f_return_due_soon" string="Return Due Soon"
                        domain="[('state','=','on_rent'), ('strx_expected_return_date','!=',False), ('strx_expected_return_date','&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="f_active" string="Active"
                        domain="[('state','in',('draft','allocated','dispatched','on_rent','returned'))]"/>
                <group>
                    <filter name="g_order" string="Order" context="{'group_by':'order_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_product" string="Specification"
                            context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_strx_cabin_allocation" model="ir.actions.act_window">
        <field name="name">Cabin Allocations</field>
        <field name="res_model">strx.cabin.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_strx_cabin_allocation_search"/>
    </record>

</odoo>
