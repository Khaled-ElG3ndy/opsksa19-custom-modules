<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_strx_quantity_increase_wizard_form" model="ir.ui.view">
        <field name="name">strx.sale.quantity.increase.wizard.form</field>
        <field name="model">strx.sale.quantity.increase.wizard</field>
        <field name="arch" type="xml">
            <form string="Quantity Increase">
                <sheet>
                    <group>
                        <field name="original_order_id"/>
                    </group>
                    <separator string="Requested Increases"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="order_line_id" column_invisible="1" force_save="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="current_qty" readonly="1"/>
                            <field name="increase_qty"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="price_unit"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_increase_order" type="object"
                            string="Create New Order" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
