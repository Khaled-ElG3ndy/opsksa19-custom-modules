<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_strx_allocated_serials" model="ir.ui.view">
        <field name="name">account.move.form.strx.allocated.serials</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                   position="after">
                <field name="strx_allocated_serial_numbers"
                       readonly="1"
                       optional="show"/>
                <field name="strx_allocated_lot_ids" column_invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
