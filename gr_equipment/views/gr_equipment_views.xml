<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gr_equipment_type_form" model="ir.ui.view">
        <field name="name">gr.equipment.type.form</field>
        <field name="model">gr.equipment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="asset_count" widget="statinfo" string="Equipment"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Rental Workflow Defaults">
                        <group>
                            <field name="rental_requires_dispatch"/>
                            <field name="rental_requires_installation"/>
                            <field name="rental_requires_meter_readings"/>
                            <field name="rental_requires_delivery_inspection"/>
                            <field name="rental_requires_return_inspection"/>
                        </group>
                        <group>
                            <field name="rental_requires_delivery_signature"/>
                            <field name="rental_requires_return_signature"/>
                            <field name="rental_standalone_ok"/>
                            <field name="rental_accessory_ok"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gr_equipment_type_list" model="ir.ui.view">
        <field name="name">gr.equipment.type.list</field>
        <field name="model">gr.equipment.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="asset_count"/>
                <field name="rental_requires_dispatch" optional="hide"/>
                <field name="rental_requires_installation" optional="show"/>
                <field name="rental_requires_meter_readings" optional="show"/>
                <field name="rental_requires_delivery_inspection" optional="show"/>
                <field name="rental_requires_return_inspection" optional="show"/>
                <field name="rental_standalone_ok" optional="show"/>
                <field name="rental_accessory_ok" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_gr_equipment_type" model="ir.actions.act_window">
        <field name="name">Equipment Types</field>
        <field name="res_model">gr.equipment.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Add owner dimension to the equipment form -->
    <record id="view_gr_equipment_form" model="ir.ui.view">
        <field name="name">gr.equipment.form.owner</field>
        <field name="model">gr.generator.asset</field>
        <field name="inherit_id" ref="gr_fleet_base.view_gr_generator_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="equipment_type_id" required="1"/>
                <field name="is_generator_type" invisible="1"/>
            </xpath>
            <!-- Ownership must be unmissable: a ribbon on the sheet plus a
                 banner directly under the title, so a third-party unit can
                 never be mistaken for a company asset. -->
            <xpath expr="//widget[@name='web_ribbon'][1]" position="before">
                <widget name="web_ribbon" title="Third-Party"
                        bg_color="text-bg-warning"
                        invisible="owner_type != 'rented_in'"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <field name="is_third_party" invisible="1"/>
                <div class="alert alert-warning mb-2" role="status"
                     invisible="owner_type != 'rented_in'">
                    <strong>Third-Party</strong>
                    <span> · </span>
                    <span>This unit is NOT a company asset. It is rented in from
                          a supplier and may only be re-rented within the
                          supplier rental period.</span>
                </div>
                <div class="mb-2" invisible="owner_type != 'owned'">
                    <span class="badge text-bg-success">Company Owned</span>
                </div>
            </xpath>
            <xpath expr="//field[@name='serial_number']" position="after">
                <field name="owner_type" widget="badge"
                       decoration-success="owner_type == 'owned'"
                       decoration-warning="owner_type == 'rented_in'"
                       decoration-info="owner_type == 'customer_owned'"/>
                <field name="owner_partner_id"
                       invisible="owner_type == 'owned'"
                       required="owner_type in ('rented_in','customer_owned')"/>
                <field name="is_rentable" readonly="1"/>
                <separator string="Rental Workflow"/>
                <field name="rental_requires_dispatch_override"/>
                <field name="rental_requires_installation_override"/>
                <field name="rental_requires_meter_readings_override"/>
                <field name="rental_requires_delivery_inspection_override"/>
                <field name="rental_requires_return_inspection_override"/>
                <field name="rental_requires_delivery_signature_override"/>
                <field name="rental_requires_return_signature_override"/>
                <field name="rental_standalone_ok_override"/>
                <field name="rental_accessory_ok_override"/>
                <field name="rental_requires_dispatch" readonly="1"/>
                <field name="rental_requires_installation" readonly="1"/>
                <field name="rental_requires_meter_readings" readonly="1"/>
                <field name="rental_requires_delivery_inspection" readonly="1"/>
                <field name="rental_requires_return_inspection" readonly="1"/>
                <field name="rental_standalone_ok" readonly="1"/>
                <field name="rental_accessory_ok" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='kva_rating']" position="attributes">
                <attribute name="invisible">not is_generator_type</attribute>
            </xpath>
            <xpath expr="//field[@name='fuel_type']" position="attributes">
                <attribute name="invisible">not is_generator_type</attribute>
            </xpath>
            <xpath expr="//field[@name='engine_model']" position="attributes">
                <attribute name="invisible">not is_generator_type</attribute>
            </xpath>
            <xpath expr="//field[@name='alternator_model']" position="attributes">
                <attribute name="invisible">not is_generator_type</attribute>
            </xpath>
            <xpath expr="//field[@name='fuel_tank_capacity']" position="attributes">
                <attribute name="invisible">not is_generator_type</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="specification"/>
                <field name="length_m"/>
                <field name="capacity"/>
                <field name="size_label"/>
                <field name="voltage_label"/>
            </xpath>
            <!-- Supplier rental block. Only rendered for third-party units, so
                 the company-fleet form stays uncluttered. gr_rental_sublet
                 extends this group with the live agreement window. -->
            <xpath expr="//notebook/page[@name='notes']" position="before">
                <page string="Supplier Rental Details" name="supplier_rental"
                      invisible="owner_type != 'rented_in'">
                    <group name="supplier_rental_group" string="Rented from Supplier">
                        <group name="supplier_rental_left">
                            <field name="owner_partner_id" string="Supplier / Owner"
                                   readonly="1"/>
                            <field name="supplier_equipment_ref"
                                   placeholder="e.g. ABC-GEN-55"/>
                        </group>
                        <group name="supplier_rental_right"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='current_rental_order_ref']" position="after">
                <field name="availability_state" widget="badge"
                       decoration-success="availability_state == 'available'"
                       decoration-info="availability_state == 'rented'"
                       decoration-warning="availability_state == 'maintenance'"
                       decoration-danger="availability_state == 'unavailable'"/>
                <field name="current_presence_type"/>
                <field name="current_rental_order_id"/>
                <field name="current_contract_id"/>
                <field name="current_site_id"/>
                <field name="current_location_label"/>
                <field name="dispatch_datetime"/>
                <field name="expected_return_datetime"/>
            </xpath>
        </field>
    </record>

    <record id="view_gr_rental_order_form_workflow_policy" model="ir.ui.view">
        <field name="name">gr.rental.order.form.workflow.policy</field>
        <field name="model">gr.rental.order</field>
        <field name="inherit_id" ref="gr_rental_order.view_gr_rental_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="rental_workflow_requires_dispatch" invisible="1"/>
                <field name="rental_workflow_requires_installation" invisible="1"/>
                <field name="rental_workflow_requires_meter_readings" invisible="1"/>
                <field name="rental_workflow_requires_delivery_inspection" invisible="1"/>
                <field name="rental_workflow_requires_return_inspection" invisible="1"/>
                <field name="rental_workflow_requires_delivery_signature" invisible="1"/>
                <field name="rental_workflow_requires_return_signature" invisible="1"/>
                <field name="rental_workflow_return_signature_due" invisible="1"/>
                <field name="rental_show_dispatch_button" invisible="1"/>
                <field name="rental_show_install_button" invisible="1"/>
                <field name="rental_show_start_rental_button" invisible="1"/>
                <field name="rental_show_start_inspection_button" invisible="1"/>
                <field name="rental_show_close_button" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_dispatch']" position="attributes">
                <attribute name="invisible">not rental_show_dispatch_button</attribute>
            </xpath>
            <xpath expr="//button[@name='action_install']" position="attributes">
                <attribute name="invisible">not rental_show_install_button</attribute>
            </xpath>
            <xpath expr="//button[@name='action_start_rental']" position="attributes">
                <attribute name="invisible">not rental_show_start_rental_button</attribute>
            </xpath>
            <xpath expr="//button[@name='action_start_inspection']" position="attributes">
                <attribute name="invisible">not rental_show_start_inspection_button</attribute>
            </xpath>
            <xpath expr="//button[@name='action_close']" position="attributes">
                <attribute name="invisible">not rental_show_close_button</attribute>
            </xpath>
            <xpath expr="//field[@name='planned_dispatch_datetime']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_dispatch</attribute>
            </xpath>
            <xpath expr="//field[@name='actual_dispatch_datetime']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_dispatch</attribute>
            </xpath>
            <xpath expr="//field[@name='planned_install_datetime']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_installation</attribute>
            </xpath>
            <xpath expr="//field[@name='actual_install_datetime']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_installation</attribute>
            </xpath>
            <xpath expr="//field[@name='start_meter_reading']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_meter_readings</attribute>
                <attribute name="readonly">state not in ('dispatched','installed')</attribute>
            </xpath>
            <xpath expr="//field[@name='end_meter_reading']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_meter_readings</attribute>
                <attribute name="readonly">state not in ('on_rent','off_hire_requested')</attribute>
            </xpath>
            <xpath expr="//field[@name='delivery_driver_id']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_dispatch</attribute>
            </xpath>
            <xpath expr="//field[@name='installation_technician_id']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_installation</attribute>
            </xpath>
            <xpath expr="//field[@name='customer_receiver_name']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_delivery_signature</attribute>
                <attribute name="required">rental_workflow_requires_delivery_signature</attribute>
            </xpath>
            <xpath expr="//field[@name='customer_receiver_signature']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_delivery_signature</attribute>
                <attribute name="required">rental_workflow_requires_delivery_signature</attribute>
            </xpath>
            <xpath expr="//field[@name='dispatch_note']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_dispatch</attribute>
            </xpath>
            <xpath expr="//field[@name='installation_note']" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_installation</attribute>
            </xpath>
            <xpath expr="//page[@name='signoff']//group[field[@name='customer_return_signature']]" position="attributes">
                <attribute name="invisible">not rental_workflow_requires_return_signature or state not in ('on_rent','off_hire_requested','returned','inspection','closed')</attribute>
            </xpath>
            <xpath expr="//field[@name='customer_return_signature']" position="attributes">
                <attribute name="required">rental_workflow_return_signature_due</attribute>
            </xpath>
        </field>
    </record>

    <!-- All-equipment list: every physical asset type, not generators only. -->
    <record id="view_gr_equipment_list" model="ir.ui.view">
        <field name="name">gr.equipment.list.all.assets</field>
        <field name="model">gr.generator.asset</field>
        <field name="inherit_id" ref="gr_fleet_base.view_gr_generator_asset_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list decoration-danger="status in ('breakdown','retired')"
                      decoration-warning="status in ('maintenance_due','under_maintenance','returned_pending_inspection')"
                      decoration-muted="status == 'retired'">
                    <field name="code" string="Asset Code"/>
                    <field name="name" string="Equipment Name"/>
                    <field name="equipment_type_id" string="Asset Type"/>
                    <field name="serial_number" string="Serial / Barcode"/>
                    <field name="status" string="Status" widget="badge"
                           decoration-success="status == 'available'"
                           decoration-info="status in ('reserved','in_transit','installed','on_rent')"
                           decoration-warning="status in ('maintenance_due','under_maintenance','returned_pending_inspection')"
                           decoration-danger="status in ('breakdown','unavailable','retired')"/>
                    <field name="availability_state" string="Availability" widget="badge"
                           decoration-success="availability_state == 'available'"
                           decoration-info="availability_state == 'rented'"
                           decoration-warning="availability_state == 'maintenance'"
                           decoration-danger="availability_state == 'unavailable'"/>
                    <field name="current_location_label" string="Current Location"/>
                    <field name="current_customer_id" string="Current Customer"/>
                    <field name="current_rental_order_id" string="Current Rental Order"/>
                    <field name="dispatch_datetime" string="Dispatch Date"/>
                    <field name="expected_return_datetime" string="Expected Return"/>
                    <field name="owner_type" string="Ownership" widget="badge"
                           decoration-success="owner_type == 'owned'"
                           decoration-warning="owner_type == 'rented_in'"
                           decoration-info="owner_type == 'customer_owned'"/>
                    <field name="owner_partner_id" string="Supplier / Owner" optional="show"/>
                    <field name="supplier_equipment_ref" string="Supplier Ref" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="view_gr_equipment_kanban" model="ir.ui.view">
        <field name="name">gr.equipment.kanban.dynamic</field>
        <field name="model">gr.generator.asset</field>
        <field name="inherit_id" ref="gr_fleet_base.view_gr_generator_asset_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="replace">
                <kanban default_group_by="status" class="o_kanban_small_column">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="equipment_type_id"/>
                    <field name="is_generator_type"/>
                    <field name="status"/>
                    <field name="availability_state"/>
                    <field name="current_location_label"/>
                    <field name="current_customer_id"/>
                    <field name="expected_return_datetime"/>
                    <field name="kva_rating"/>
                    <field name="current_hour_meter"/>
                    <field name="next_pm_hour"/>
                    <field name="utilization_hours_total"/>
                    <field name="specification"/>
                    <field name="length_m"/>
                    <field name="capacity"/>
                    <field name="size_label"/>
                    <field name="voltage_label"/>
                    <field name="owner_type"/>
                    <field name="is_third_party"/>
                    <field name="owner_partner_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="code"/>
                                        </strong>
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="name"/>
                                        </small>
                                    </div>
                                    <div class="d-flex gap-1 flex-wrap justify-content-end">
                                        <field name="availability_state" widget="badge"
                                               decoration-success="availability_state == 'available'"
                                               decoration-info="availability_state == 'rented'"
                                               decoration-warning="availability_state == 'maintenance'"
                                               decoration-danger="availability_state == 'unavailable'"/>
                                        <field name="status" widget="badge"/>
                                    </div>
                                </div>
                                <!-- Ownership sits above everything else on the
                                     card: on a kanban wall the badge is the
                                     only thing separating our fleet from a
                                     supplier's unit. -->
                                <div class="o_kanban_record_body">
                                    <div t-if="record.is_third_party.raw_value" class="mb-1">
                                        <span class="badge text-bg-warning">Third-Party</span>
                                        <div t-if="record.owner_partner_id.raw_value" class="small text-muted">
                                            <span>Supplier: </span><field name="owner_partner_id"/>
                                        </div>
                                    </div>
                                    <div t-if="record.owner_type.raw_value == 'owned'" class="mb-1">
                                        <span class="badge text-bg-success">Company Owned</span>
                                    </div>
                                    <div t-if="record.owner_type.raw_value == 'customer_owned'" class="mb-1">
                                        <span class="badge text-bg-info">Customer-owned</span>
                                    </div>
                                    <div><field name="equipment_type_id"/></div>
                                    <div t-if="record.current_location_label.raw_value">
                                        <span>Location: </span><field name="current_location_label"/>
                                    </div>
                                    <div t-if="record.current_customer_id.raw_value">
                                        <span>Customer: </span><field name="current_customer_id"/>
                                    </div>
                                    <div t-if="record.expected_return_datetime.raw_value">
                                        <span>Expected Return: </span><field name="expected_return_datetime"/>
                                    </div>
                                    <div t-if="record.is_generator_type.raw_value" class="mt-2">
                                        <span>Capacity: </span><field name="kva_rating"/><span> kVA</span><br/>
                                        <span>Meter: </span><field name="current_hour_meter"/><span> h</span><br/>
                                        <span>Next PM: </span><field name="next_pm_hour"/><span> h</span><br/>
                                        <span>Utilization: </span><field name="utilization_hours_total"/><span> h</span>
                                    </div>
                                    <div t-if="!record.is_generator_type.raw_value" class="mt-2">
                                        <div t-if="record.specification.raw_value">
                                            <span>Specification: </span><field name="specification"/>
                                        </div>
                                        <div t-if="record.length_m.raw_value">
                                            <span>Length: </span><field name="length_m"/><span> m</span>
                                        </div>
                                        <div t-if="record.capacity.raw_value">
                                            <span>Capacity: </span><field name="capacity"/>
                                        </div>
                                        <div t-if="record.size_label.raw_value">
                                            <span>Size: </span><field name="size_label"/>
                                        </div>
                                        <div t-if="record.voltage_label.raw_value">
                                            <span>Voltage: </span><field name="voltage_label"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </xpath>
        </field>
    </record>

    <!-- Relabel to "Equipment" to match ABSAL's paperwork (Asset No is the key field) -->
    <record id="gr_fleet_base.menu_gr_assets_root" model="ir.ui.menu">
        <field name="name">Equipment</field>
    </record>
    <record id="gr_fleet_base.action_gr_generator_asset" model="ir.actions.act_window">
        <field name="name">All Equipment</field>
        <field name="view_mode">list,kanban,form,pivot</field>
    </record>

    <!-- Owner-type filters and grouping in search -->
    <record id="view_gr_equipment_search" model="ir.ui.view">
        <field name="name">gr.equipment.search.owner</field>
        <field name="model">gr.generator.asset</field>
        <field name="inherit_id" ref="gr_fleet_base.view_gr_generator_asset_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="replace">
                <search>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="equipment_type_id"/>
                    <field name="serial_number"/>
                    <field name="current_customer_id"/>
                    <field name="current_rental_order_id"/>
                    <separator/>
                    <filter name="f_available" string="Available"
                            domain="[('availability_state','=','available')]"/>
                    <filter name="f_rented" string="Rented / Reserved"
                            domain="[('availability_state','=','rented')]"/>
                    <filter name="f_maintenance" string="In Maintenance"
                            domain="[('availability_state','=','maintenance')]"/>
                    <filter name="f_unavailable" string="Unavailable"
                            domain="[('availability_state','=','unavailable')]"/>
                    <separator/>
                    <filter name="f_reserved" string="Reserved"
                            domain="[('status','=','reserved')]"/>
                    <filter name="f_on_rent" string="On Rent"
                            domain="[('status','=','on_rent')]"/>
                    <filter name="f_status_maintenance" string="Under Maintenance"
                            domain="[('status','in',('maintenance_due','under_maintenance'))]"/>
                    <filter name="f_inspection" string="Pending Inspection"
                            domain="[('status','=','returned_pending_inspection')]"/>
                    <filter name="f_status_unavailable" string="Unavailable Status"
                            domain="[('status','in',('unavailable','breakdown','retired'))]"/>
                    <separator/>
                    <filter name="f_owned" string="Company Owned" domain="[('owner_type','=','owned')]"/>
                    <filter name="f_rented_in" string="Third-Party"
                            domain="[('owner_type','=','rented_in')]"/>
                    <filter name="f_customer_owned" string="Customer-owned" domain="[('owner_type','=','customer_owned')]"/>
                    <filter name="f_current_customer" string="Has Current Customer"
                            domain="[('current_customer_id','!=',False)]"/>
                    <filter name="f_active_rental_order" string="Has Active Rental Order"
                            domain="[('current_rental_order_id','!=',False)]"/>
                    <filter name="f_rentable" string="Rentable" domain="[('is_rentable','=',True)]"/>
                    <separator/>
                    <filter name="f_inactive" string="Archived"
                            domain="[('active', '=', False)]"/>
                    <group>
                        <filter name="g_type" string="Asset Type" context="{'group_by': 'equipment_type_id'}"/>
                        <filter name="g_availability" string="Availability" context="{'group_by': 'availability_state'}"/>
                        <filter name="g_status" string="Status" context="{'group_by': 'status'}"/>
                        <filter name="g_location" string="Location" context="{'group_by': 'current_location_label'}"/>
                        <filter name="g_customer" string="Current Customer" context="{'group_by': 'current_customer_id'}"/>
                        <filter name="g_owner" string="Ownership" context="{'group_by': 'owner_type'}"/>
                        <filter name="g_company" string="Company" context="{'group_by': 'company_id'}"
                                groups="base.group_multi_company"/>
                    </group>
                    <searchpanel>
                        <field name="equipment_type_id" string="Asset Type"/>
                        <field name="availability_state" string="Availability" select="multi"/>
                        <field name="status" string="Status" select="multi"/>
                        <field name="depot_location_id" string="Location"/>
                    </searchpanel>
                </search>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Ownership-separated views.                                   -->
    <!--                                                              -->
    <!-- One model, two doors. Third-party equipment shares the asset -->
    <!-- spine (so rentals, maintenance, inspections and history all  -->
    <!-- keep working), but the business UI never presents it as part -->
    <!-- of the owned fleet. Separation is by action domain, not by   -->
    <!-- record rule, so administrators still see everything.         -->
    <!-- ============================================================ -->
    <record id="action_gr_equipment_availability" model="ir.actions.act_window">
        <field name="name">Equipment Availability</field>
        <field name="res_model">gr.generator.asset</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="context">{'search_default_g_availability': 1}</field>
        <field name="search_view_id" ref="gr_fleet_base.view_gr_generator_asset_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track equipment availability</p>
            <p>Use this screen to review available, rented, maintenance and
               unavailable equipment before committing rental dates.</p>
        </field>
    </record>

    <record id="action_gr_equipment_owned" model="ir.actions.act_window">
        <field name="name">Owned Assets</field>
        <field name="res_model">gr.generator.asset</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="domain">[('owner_type', '=', 'owned')]</field>
        <field name="context">{'default_owner_type': 'owned'}</field>
        <field name="search_view_id" ref="gr_fleet_base.view_gr_generator_asset_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register the company's own rental fleet</p>
            <p>These are real company-owned assets. Equipment rented in from a
               supplier belongs under Third-Party Rented Equipment.</p>
        </field>
    </record>

    <record id="action_gr_equipment_third_party" model="ir.actions.act_window">
        <field name="name">Third-Party Rented Equipment</field>
        <field name="res_model">gr.generator.asset</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="domain">[('owner_type', '=', 'rented_in')]</field>
        <field name="context">{'default_owner_type': 'rented_in'}</field>
        <field name="search_view_id" ref="gr_fleet_base.view_gr_generator_asset_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register equipment rented in from a supplier</p>
            <p>These units are NOT company assets. They are rented in from a
               supplier and re-rented to customers only within the supplier's
               rental period.</p>
        </field>
    </record>

    <menuitem id="menu_gr_equipment_availability"
              name="Equipment Availability"
              parent="gr_fleet_base.menu_gr_assets_root"
              action="action_gr_equipment_availability"
              groups="gr_security_base.group_generator_user"
              sequence="10"/>

    <menuitem id="menu_gr_equipment_owned"
              name="Owned Assets"
              parent="gr_fleet_base.menu_gr_assets_root"
              action="action_gr_equipment_owned"
              groups="gr_security_base.group_generator_user"
              sequence="20"/>

    <!-- The whole third-party workflow gets one navigation home: the
         equipment list, and (added by gr_rental_sublet, which owns them) the
         supplier agreements, exposure and margin screens. This menu is a
         container with no action of its own so the group reads as a section
         rather than as a screen that also happens to have children. -->
    <menuitem id="menu_gr_equipment_third_party"
              name="Third-Party Rented Equipment"
              parent="gr_fleet_base.menu_gr_assets_root"
              groups="gr_security_base.group_generator_user"
              sequence="30"/>

    <!-- This menu used to open the equipment list directly. Omitting `action`
         on the menuitem above does not clear a value already in the database,
         so an upgraded instance would keep the old action and render the
         section header as a clickable screen. Clear it explicitly. -->
    <record id="menu_gr_equipment_third_party" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <menuitem id="menu_gr_equipment_third_party_list"
              name="Third-Party Rented Equipment"
              parent="menu_gr_equipment_third_party"
              action="action_gr_equipment_third_party"
              groups="gr_security_base.group_generator_user"
              sequence="10"/>

    <menuitem id="menu_gr_equipment_type"
              name="Equipment Types"
              parent="gr_fleet_base.menu_gr_assets_root"
              action="action_gr_equipment_type"
              groups="gr_security_base.group_generator_operations_officer"
              sequence="80"/>

</odoo>
