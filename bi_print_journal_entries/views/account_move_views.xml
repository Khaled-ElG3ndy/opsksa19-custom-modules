<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_print_journal_entries" model="ir.ui.view">
        <field name="name">account.move.form.print.journal.entry</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_print_journal_entry"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-print"
                        invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Print Entry</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
