<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_gr_rental_contract" model="report.paperformat">
        <field name="name">Rental Contract A4 Compact</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_gr_rental_contract" model="ir.actions.report">
        <field name="name">Rental Contract</field>
        <field name="model">gr.rental.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gr_contract.report_gr_rental_contract</field>
        <field name="report_file">gr_contract.report_gr_rental_contract</field>
        <field name="print_report_name">'Contract - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_gr_rental_contract"/>
        <field name="binding_model_id" ref="model_gr_rental_contract"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
