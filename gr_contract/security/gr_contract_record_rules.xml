<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_gr_rental_contract_company" model="ir.rule">
            <field name="name">Rental Contract: multi-company</field>
            <field name="model_id" ref="model_gr_rental_contract"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_gr_rental_contract_line_company" model="ir.rule">
            <field name="name">Rental Contract Line: multi-company</field>
            <field name="model_id" ref="model_gr_rental_contract_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_gr_contract_amendment_company" model="ir.rule">
            <field name="name">Contract Amendment: multi-company</field>
            <field name="model_id" ref="model_gr_contract_amendment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
