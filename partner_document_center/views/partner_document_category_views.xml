<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_document_category_view_list" model="ir.ui.view">
        <field name="name">partner.document.category.list</field>
        <field name="model">partner.document.category</field>
        <field name="arch" type="xml">
            <list string="Document Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="partner_document_category_view_form" model="ir.ui.view">
        <field name="name">partner.document.category.form</field>
        <field name="model">partner.document.category</field>
        <field name="arch" type="xml">
            <form string="Document Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_document_category_action" model="ir.actions.act_window">
        <field name="name">Document Categories</field>
        <field name="res_model">partner.document.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a document category</p>
            <p>Categories let you label the files that appear in a contact's Document Center.</p>
        </field>
    </record>

</odoo>
