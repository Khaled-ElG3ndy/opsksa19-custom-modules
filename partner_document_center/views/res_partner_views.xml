<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_document_center" model="ir.ui.view">
        <field name="name">res.partner.form.document.center</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!--
                The count is fetched by the widget after the form is painted,
                not by a computed field: aggregating every source on each form
                load (and on every row of a list view) would be exactly the
                kind of work this feature must not add to a contact form.
            -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <widget name="partner_document_center_button"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Document Center" name="document_center">
                    <widget name="partner_document_center"/>
                </page>
            </xpath>

        </field>
    </record>

    <record id="partner_document_center_action" model="ir.actions.client">
        <field name="name">Document Center</field>
        <field name="tag">partner_document_center</field>
    </record>

</odoo>
