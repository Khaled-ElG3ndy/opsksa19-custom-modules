<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Grant the base administrator the Generator Administrator group on
             install, so the Generator Rental ERP app is immediately visible and
             usable without a manual group assignment. noupdate=1 so a later
             manual change by the customer is never overwritten on upgrade. -->
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('gr_security_base.group_generator_administrator'))]"/>
        </record>
    </data>
</odoo>
