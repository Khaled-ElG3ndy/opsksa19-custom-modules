<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ITEM TYPE (the catalogue the client extends) -->
    <record id="view_gr_rental_item_type_form" model="ir.ui.view">
        <field name="name">gr.rental.item.type.form</field>
        <field name="model">gr.rental.item.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Cable, Fuel Tank, Distribution Panel"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="CBL"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_daily_rate"/>
                            <field name="default_is_free_with_generator"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this item is..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gr_rental_item_type_list" model="ir.ui.view">
        <field name="name">gr.rental.item.type.list</field>
        <field name="model">gr.rental.item.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_daily_rate"/>
                <field name="default_is_free_with_generator"/>
                <field name="unit_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_gr_rental_item_type" model="ir.actions.act_window">
        <field name="name">Rentable Item Types</field>
        <field name="res_model">gr.rental.item.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add any item you rent — cable, fuel tank, panel, or anything else</p>
        </field>
    </record>

    <!-- ITEM UNIT (individual physical items) -->
    <record id="view_gr_rental_item_unit_form" model="ir.ui.view">
        <field name="name">gr.rental.item.unit.form</field>
        <field name="model">gr.rental.item.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="item_type_id"/>
                            <field name="serial_number"/>
                            <field name="specification" placeholder="e.g. 4-core 120mm 50m"/>
                        </group>
                        <group>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'available'"
                                   decoration-warning="status == 'on_rent'"
                                   decoration-danger="status in ('maintenance','unavailable')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gr_rental_item_unit_list" model="ir.ui.view">
        <field name="name">gr.rental.item.unit.list</field>
        <field name="model">gr.rental.item.unit</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'available'"
                  decoration-warning="status == 'on_rent'"
                  decoration-muted="status == 'retired'">
                <field name="name"/>
                <field name="item_type_id"/>
                <field name="specification"/>
                <field name="serial_number"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'on_rent'"/>
            </list>
        </field>
    </record>

    <record id="view_gr_rental_item_unit_search" model="ir.ui.view">
        <field name="name">gr.rental.item.unit.search</field>
        <field name="model">gr.rental.item.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="item_type_id"/>
                <field name="serial_number"/>
                <filter name="f_available" string="Available" domain="[('status','=','available')]"/>
                <filter name="f_on_rent" string="On Rent" domain="[('status','=','on_rent')]"/>
                <group>
                    <filter name="g_type" string="Item Type" context="{'group_by':'item_type_id'}"/>
                    <filter name="g_status" string="Status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gr_rental_item_unit" model="ir.actions.act_window">
        <field name="name">Rentable Items</field>
        <field name="res_model">gr.rental.item.unit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gr_rental_item_unit_search"/>
    </record>

    <record id="view_gr_equipment_form_rental_pricing" model="ir.ui.view">
        <field name="name">gr.equipment.form.rental.pricing</field>
        <field name="model">gr.generator.asset</field>
        <field name="inherit_id" ref="gr_equipment.view_gr_equipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_rentable']" position="after">
                <field name="rental_daily_rate"
                       invisible="not is_rentable"/>
                <field name="default_is_free_with_asset"
                       invisible="not is_rentable"/>
            </xpath>
        </field>
    </record>

</odoo>
