<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dash_maint_pivot" model="ir.ui.view">
        <field name="name">dash.maint.pivot</field>
        <field name="model">gr.maintenance.job</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Jobs">
                <field name="job_type" type="row"/>
                <field name="state" type="col"/>
                <field name="downtime_hours" type="measure"/>
                <field name="labor_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dash_maint_graph" model="ir.ui.view">
        <field name="name">dash.maint.graph</field>
        <field name="model">gr.maintenance.job</field>
        <field name="arch" type="xml">
            <graph string="Jobs by Type" type="bar">
                <field name="job_type"/>
            </graph>
        </field>
    </record>

    <record id="action_dash_maint_jobs" model="ir.actions.act_window">
        <field name="name">Maintenance Overview</field>
        <field name="res_model">gr.maintenance.job</field>
        <field name="view_mode">pivot,graph,list,form</field>
    </record>

    <!-- Overdue assets shortcut -->
    <record id="action_dash_overdue_assets" model="ir.actions.act_window">
        <field name="name">Assets Needing Maintenance</field>
        <field name="res_model">gr.generator.asset</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">['|',('maintenance_overdue','=',True),('status','in',('maintenance_due','breakdown','under_maintenance'))]</field>
    </record>

    <record id="action_dash_returned_assets" model="ir.actions.act_window">
        <field name="name">Returned - Pending Inspection</field>
        <field name="res_model">gr.generator.asset</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('status','=','returned_pending_inspection')]</field>
    </record>

</odoo>
