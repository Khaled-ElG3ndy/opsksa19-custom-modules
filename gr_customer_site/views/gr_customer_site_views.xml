<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Form view                                                    -->
    <!-- ============================================================ -->
    <record id="view_gr_customer_site_form" model="ir.ui.view">
        <field name="name">gr.customer.site.form</field>
        <field name="model">gr.customer.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart-button placeholders; counts come online as the
                             related models are added in later milestones. -->
                        <button class="oe_stat_button" icon="fa-file-text-o" disabled="1">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-truck" disabled="1">
                            <field name="rental_order_count" widget="statinfo" string="Rental Orders"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-bolt" disabled="1">
                            <field name="installed_generator_count" widget="statinfo" string="Installed"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-clock-o" disabled="1">
                            <field name="hour_log_count" widget="statinfo" string="Hour Logs"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-wrench" disabled="1">
                            <field name="maintenance_job_count" widget="statinfo" string="Maint. Jobs"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary"
                            invisible="active"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Riyadh Tower - Phase 2"/></h1>
                        <label for="code"/>
                        <h2><field name="code" readonly="1"/></h2>
                    </div>

                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="contact_phone"/>
                            <field name="contact_email"/>
                            <field name="customer_po_required"/>
                        </group>
                        <group string="Site">
                            <field name="site_type"/>
                            <field name="required_load_kw"/>
                            <field name="required_kva"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Location">
                            <field name="region"/>
                            <field name="city"/>
                            <field name="district"/>
                            <field name="street"/>
                            <field name="gps_latitude"/>
                            <field name="gps_longitude"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Load Profile" name="load">
                            <field name="load_profile_notes" placeholder="Load profile details..."/>
                        </page>
                        <page string="Access &amp; Safety" name="access">
                            <group>
                                <field name="access_instructions" placeholder="How to access the site..."/>
                                <field name="safety_requirements" placeholder="PPE, permits, hazards..."/>
                                <field name="working_hours_policy" placeholder="Allowed working hours..."/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- List view                                                    -->
    <!-- ============================================================ -->
    <record id="view_gr_customer_site_list" model="ir.ui.view">
        <field name="name">gr.customer.site.list</field>
        <field name="model">gr.customer.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="site_type"/>
                <field name="city"/>
                <field name="required_kva"/>
                <field name="customer_po_required"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Kanban view                                                  -->
    <!-- ============================================================ -->
    <record id="view_gr_customer_site_kanban" model="ir.ui.view">
        <field name="name">gr.customer.site.kanban</field>
        <field name="model">gr.customer.site</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="site_type"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="code"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span><field name="partner_id"/></span><br/>
                                <span><field name="city"/> &#8226; <field name="required_kva"/> kVA</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search view                                                  -->
    <!-- ============================================================ -->
    <record id="view_gr_customer_site_search" model="ir.ui.view">
        <field name="name">gr.customer.site.search</field>
        <field name="model">gr.customer.site</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="city"/>
                <field name="region"/>
                <separator/>
                <filter name="f_po_required" string="PO Required"
                        domain="[('customer_po_required', '=', True)]"/>
                <filter name="f_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="g_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_type" string="Site Type" context="{'group_by': 'site_type'}"/>
                    <filter name="g_city" string="City" context="{'group_by': 'city'}"/>
                    <filter name="g_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Pivot view                                                   -->
    <!-- ============================================================ -->
    <record id="view_gr_customer_site_pivot" model="ir.ui.view">
        <field name="name">gr.customer.site.pivot</field>
        <field name="model">gr.customer.site</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="site_type" type="row"/>
                <field name="required_kva" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action                                                       -->
    <!-- ============================================================ -->
    <record id="action_gr_customer_site" model="ir.actions.act_window">
        <field name="name">Customer Sites</field>
        <field name="res_model">gr.customer.site</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="search_view_id" ref="view_gr_customer_site_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first customer site
            </p>
            <p>
                A site is a physical project location where generators are
                installed, linked to the customer who operates it.
            </p>
        </field>
    </record>

</odoo>
