<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Supplier-return buffer thresholds, in whole days between the customer
         returning a third-party unit and the date it is due back to the
         supplier.

         Policy numbers, so they live here as system parameters an
         administrator can change under Settings > Technical > System
         Parameters, rather than being hardcoded on every screen that shows
         the warning. noupdate="1" so a module update never overwrites a value
         the business has tuned.

         buffer <= critical  -> red    "no return buffer"
         buffer <= warning   -> orange "tight return buffer"
         buffer >  warning   -> calm, nothing shown -->
    <data noupdate="1">
        <record id="param_supplier_buffer_critical_days" model="ir.config_parameter">
            <field name="key">gr_rental_sublet.supplier_buffer_critical_days</field>
            <field name="value">2</field>
        </record>
        <record id="param_supplier_buffer_warning_days" model="ir.config_parameter">
            <field name="key">gr_rental_sublet.supplier_buffer_warning_days</field>
            <field name="value">5</field>
        </record>
    </data>
</odoo>
